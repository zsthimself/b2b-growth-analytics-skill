# ==============================================================================
# Google Cloud OAuth 2.0 Credentials (Desktop Application)
# ==============================================================================
# Path to your downloaded OAuth 2.0 client secret JSON file from Google Cloud Console
GOOGLE_OAUTH_CLIENT_FILE="./credentials/client_secret.json"

# Path where authorized access/refresh token will be stored (auto-generated)
GOOGLE_TOKEN_FILE="./credentials/token.json"

# ==============================================================================
# Google Ads API Settings
# ==============================================================================
# Path to the file containing your 22-character Google Ads Developer Token
GOOGLE_ADS_DEVELOPER_TOKEN_FILE="./credentials/developer-token.txt"

# Optional: MCC Manager Account ID (10 digits without hyphens, e.g. 1234567890).
# Leave empty or omit if accessing a direct/standalone Google Ads account without MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# Primary Google Ads Operating Customer ID (10 digits without hyphens, e.g. 9876543210)
GOOGLE_ADS_CUSTOMER_ID="1234567890"

# Target Google Ads Shared Negative Keyword List ID (e.g. 11916267503) for automated injection
GOOGLE_ADS_SHARED_NEGATIVE_LIST_ID=""

# API Version (defaults to v25 if unset)
GOOGLE_ADS_API_VERSION="v25"

# ==============================================================================
# Google Analytics 4 (GA4) Settings
# ==============================================================================
# Your GA4 Property ID (numeric, e.g. 123456789)
GA4_PROPERTY_ID="123456789"

# ==============================================================================
# Google Search Console (GSC) Settings
# ==============================================================================
# Your GSC Site URL (e.g. sc-domain:example.com or https://example.com/)
GSC_SITE_URL="sc-domain:example.com"

# ==============================================================================
# Optional Ground Truth Lead Tracking (CRM / Sheet)
# ==============================================================================
# Local path to an inquiries CSV or Excel export for automated CPL reconciliation
INQUIRIES_DATA_PATH="./data/inquiries_export.csv"
